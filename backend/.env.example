PORT=5000
NODE_ENV=development

# Database Options: 'sqlite', 'postgres', or 'mysql'
DB_TYPE=sqlite

# If PostgreSQL:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=library_db
# DB_USER=postgres
# DB_PASSWORD=your_password

# If MySQL:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=library_db
# DB_USER=root
# DB_PASSWORD=your_password
